  "obfuscation": {
    "priority": [
      "dish",
      "mask",
      "layout",
      "insert"
    ],
    "note": "对外稿先换成 dish。漏网的拉丁/汉字敏感词再套 mask。DECODE 先去插入符，再 layout 逆映射，再查 masks/aliases。ghbvth =  пример（俄文按 QWERTY 键位）。",
    "insert_chars": " ._-*#@!|/+'\"",
    "methods": {
      "insert_space": "字母间插空格：webshell → w e b s h e l l",
      "insert_symbol": "字母间插 insert_chars：server → s*e_r.v#e!r",
      "cjk_space": "汉字间插空：服务器 → 服 务 器",
      "layout_ru": "把词先译成俄文，再按 ЙЦУКЕН 键位打成拉丁。пример→ghbvth，привет→ghbdtn，сервер→cthdth。英词直接按俄文键盘键位：shell→ырудд，webshell→цуиырудд，server→ыукмук"
    },
    "en_keys": "qwertyuiop[]asdfghjkl;'zxcvbnm,.",
    "ru_keys": "йцукенгшщзхъфывапролджэячсмитьбю",
    "layout_examples": {
      "ghbvth": "пример",
      "ghbdtn": "привет",
      "cthdth": "сервер",
      "ыукмук": "server",
      "цуиырудд": "webshell",
      "ырудд": "shell"
    },
    "decode_steps": [
      "整词查 dish / aliases / masks",
      "去掉 insert_chars 与内部空格后再查",
      "en_keys→ru_keys 映射后再查 gloss（ghbvth→пример）",
      "ru_keys→en_keys 映射后再查英词（ырудд→shell）",
      "命中则换成 sec，未命中标【缺菜谱】"
    ]
  }
